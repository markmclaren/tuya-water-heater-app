# =============================================================
# .env — credentials for test_app_logic.py
# Copy this file to .env and fill in your own values.
# .env is gitignored and will never be committed.
# =============================================================

# Tuya Cloud API Credentials
# https://iot.tuya.com → Cloud → Your Project → Overview
TUYA_CLIENT_ID=your_client_id_here
TUYA_CLIENT_SECRET=your_client_secret_here
TUYA_REGION=eu
TUYA_REGION_URL=https://openapi.tuyaeu.com

# Device IDs
TUYA_WATER_TANK_DEVICE_ID=your_water_tank_device_id_here
